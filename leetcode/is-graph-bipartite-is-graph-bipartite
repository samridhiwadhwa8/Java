class Solution {
    public boolean isBipartite(int[][] graph) {
        // HashMap<Integer,ArrayList<Integer>> map=new HashMap<>();
        int n=graph.length;
        int[] color=new int[n];
        Arrays.fill(color,-1);
        for(int i=0;i<n;i++){
            if(color[i]==-1){
               if(!dfs(graph,color,i,0))return false;
            }
        }
        return true;
    }
    public boolean dfs(int[][] map,int[] color,int currnode,int currcolor){
        color[currnode]=currcolor;
        for(int v:map[currnode]){
            if(color[v]==color[currnode])return false;
            if(color[v]==-1){
                color[v]=1-currcolor;
                if(dfs(map,color,v,color[v])==false)return false;
            }
        }
        return true;
    }
}
