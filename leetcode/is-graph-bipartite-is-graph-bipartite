    public boolean bfs(int[][] map,int[] color,int currnode,int currcolor){
        Queue<Integer> q=new LinkedList<>();
        color[currnode]=currcolor;
        q.add(currnode);
        while(!q.isEmpty()){
            int n=q.poll();
            for(int v:map[n]){
                if(color[v]==color[n])return false;
                if(color[v]==-1){
                    color[v]=1-color[n];
                    q.add(v);
                }
            }
        }
        return true;
    }
}
